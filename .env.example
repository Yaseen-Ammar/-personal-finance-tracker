# Copy this file to ".env" and fill in real values. NEVER commit ".env".

FLASK_APP=wsgi.py
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Display currency. Presentation only: stored amounts are exact decimals, so
# you can change these at any time without a database migration.
#   CURRENCY_CODE   = ISO 4217 code (USD, GBP, EUR, JPY, ...)
#   CURRENCY_LOCALE = number format (en_US -> $1,234.50, en_GB -> £1,234.50, de_DE -> 1.234,50 €)
CURRENCY_CODE=USD
CURRENCY_LOCALE=en_US

MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=personal_finance_tracker
